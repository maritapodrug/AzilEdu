@page "/housing-units"
@rendermode InteractiveServer
@using AzilEdu.Shared.DTOs
@using System.Net.Http.Json
@inject HttpClient Http
@inject IDialogService DialogService

<PageTitle>Smještajne jedinice</PageTitle>

<MudText Typo="Typo.h4" Class="mb-2">Popis smještajnih jedinica</MudText>
<MudText Typo="Typo.body1" Class="mb-4">
    Ovdje se prikazuje pregled smještajnih jedinica za životinje koje se trenutačno nalaze u azilu.
</MudText>

@if (!string.IsNullOrWhiteSpace(errorMessage))
{
    <MudAlert Severity="Severity.Error" Class="mb-4">@errorMessage</MudAlert>
}

@if (isLoading)
{
    <div class="d-flex justify-center my-6">
        <MudProgressCircular Indeterminate="true" Color="Color.Primary" />
    </div>
}
else
{

<MudGrid Class="mb-4">
    <MudItem xs="12" sm="4">
        <MudPaper Class="pa-4">
            <MudText Typo="Typo.subtitle2">Ukupan broj jedinica</MudText>
            <MudText Typo="Typo.h5">@TotalUnits</MudText>
        </MudPaper>
    </MudItem>
    <MudItem xs="12" sm="4">
        <MudPaper Class="pa-4">
            <MudText Typo="Typo.subtitle2">Broj aktivnih jedinica</MudText>
            <MudText Typo="Typo.h5">@NumberOfActive</MudText>
        </MudPaper>
    </MudItem>
    <MudItem xs="12" sm="4">
        <MudPaper Class="pa-4">
            <MudText Typo="Typo.subtitle2">Broj punih jedinica</MudText>
            <MudText Typo="Typo.h5">@NumberOfFull</MudText>
        </MudPaper>
    </MudItem>
    <MudItem xs="12" sm="4">
        <MudPaper Class="pa-4">
            <MudText Typo="Typo.subtitle2">Ukupan slobodni kapacitet</MudText>
            <MudText Typo="Typo.h5">@FreeCapacity</MudText>
        </MudPaper>
    </MudItem>
</MudGrid>

<MudButtonGroup Color="Color.Primary" Variant="Variant.Outlined" Class="mb-4">
    <MudButton OnClick="@ShowAll">Sve</MudButton>
    <MudButton OnClick="@ShowActive">Aktivne</MudButton>
    <MudButton OnClick="@ShowFull">Pune</MudButton>
    <MudButton OnClick="@ShowWithFreeCapacity">Sa slobodnim mjestima</MudButton>
</MudButtonGroup>
<MudButton Variant="Variant.Filled" Color="Color.Primary" Href="/housing-units/create" Class="mb-4">
    Nova smještajna jedinica
</MudButton>
<MudTable Items="@FilteredHousingUnits" Hover="true" Striped="true" Bordered="true" Dense="true">
    <HeaderContent>
        <MudTh>Slika</MudTh>
        <MudTh>Naziv</MudTh>
        <MudTh>Tip</MudTh>
        <MudTh>Kapacitet</MudTh>
        <MudTh>Zauzeto</MudTh>
        <MudTh>Slobodno</MudTh>
        <MudTh>Zadnje čišćenje</MudTh>
        <MudTh>Status</MudTh>
        <MudTh>Akcije</MudTh>
    </HeaderContent>
    <RowTemplate>
        <MudTd DataLabel="Slika">
            <MudAvatar Size="Size.Large">
                <MudImage Src="@context.ImageUrl" Alt="@context.Name" />
            </MudAvatar>
        </MudTd>
        <MudTd DataLabel="Naziv">@context.Name</MudTd>
        <MudTd DataLabel="Tip">@context.UnitType</MudTd>
        <MudTd DataLabel="Kapacitet">@context.Capacity</MudTd>
        <MudTd DataLabel="Zauzeto">@context.Occupied</MudTd>
        <MudTd DataLabel="Slobodno">@GetFreeCapacity(context)</MudTd>
        <MudTd DataLabel="Zadnje čišćenje">@GetCleaningDateText(context)</MudTd>
        <MudTd DataLabel="Status">
            <MudChip T="string"
                     Color="@GetUnitStatusColor(context)"
                     Variant="Variant.Filled">
                @GetUnitStatusText(context)
            </MudChip>
        </MudTd>
        <MudTd>
            <MudButton Variant="Variant.Text" Color="Color.Primary" Href="@($"/housing-units/edit/{context.Id}")">
                Uredi
            </MudButton>
            <MudButton Variant="Variant.Text" Color="Color.Error" OnClick="@(() => DeleteHousingUnit(context.Id))">
                Obriši
            </MudButton>
        </MudTd>
    </RowTemplate>

    <NoRecordsContent>
        <MudText Typo="Typo.body1" Class="pa-4">
            Nema smještajnih jedinica za odabrani filter.
        </MudText>
    </NoRecordsContent>
</MudTable>
}

@code {
    private string selectedStatus = "Sve";
    private List<HousingUnitDto> housingUnits = new();
    private bool isLoading = true;
    private string? errorMessage;

    private int TotalUnits    => housingUnits.Count;
    private int NumberOfActive => housingUnits.Count(u => u.IsActive);
    private int NumberOfFull   => housingUnits.Count(u => u.Capacity == u.Occupied);
    private int FreeCapacity   => housingUnits.Sum(u => GetFreeCapacity(u));

    protected override async Task OnInitializedAsync()
    {
        try
        {
            housingUnits = await Http.GetFromJsonAsync<List<HousingUnitDto>>("api/housing-units") ?? new();
        }
        catch (Exception ex) { errorMessage = $"Greška kod učitavanja: {ex.Message}"; }
        finally { isLoading = false; }
    }

    private IEnumerable<HousingUnitDto> FilteredHousingUnits =>
            selectedStatus switch
            {
                "Aktivne" => housingUnits.Where(HousingUnit => HousingUnit.IsActive),
                "Pune" => housingUnits.Where(HousingUnit => HousingUnit.Capacity==HousingUnit.Occupied),
                "Sa slobodnim mjestima" => housingUnits.Where(HousingUnit => HousingUnit.IsActive && HousingUnit.Capacity != HousingUnit.Occupied),
                _ => housingUnits
            };

    private void ShowAll()
    {
        selectedStatus = "Sve";
    }

    private void ShowActive()
    {
        selectedStatus = "Aktivne";
    }

    private void ShowFull()
    {
        selectedStatus = "Pune";
    }

    private void ShowWithFreeCapacity()
    {
        selectedStatus = "Sa slobodnim mjestima";
    }


    private int GetFreeCapacity(HousingUnitDto unit)
    {
        return unit.Capacity - unit.Occupied;
    }

    private string GetCleaningDateText(HousingUnitDto unit)
    {
        if (unit.LastCleanedAt.HasValue)
        {
            return unit.LastCleanedAt.Value.ToShortDateString();
        }

        return "Nije uneseno";
    }

    private Color GetUnitStatusColor(HousingUnitDto unit)
    {
        if (!unit.IsActive)
        {
            return Color.Default;
        }

        if (unit.Occupied >= unit.Capacity)
        {
            return Color.Error;
        }

        return Color.Success;
    }

    private string GetUnitStatusText(HousingUnitDto unit)
    {
        if (!unit.IsActive)
        {
            return "Neaktivno";
        }

        if (unit.Occupied >= unit.Capacity)
        {
            return "Puno";
        }

        return "Slobodno";
    }

    private async Task DeleteHousingUnit(int id)
    {
        var options = new DialogOptions { CloseOnEscapeKey = true };
        var dialog  = await DialogService.ShowAsync<ConfirmDialog>("Potvrda brisanja", options);
        var result  = await dialog.Result;
        if (result is null || result.Canceled) return;

        try
        {
            var response = await Http.DeleteAsync($"api/housing-units/{id}");
            if (response.IsSuccessStatusCode)
                housingUnits = housingUnits.Where(u => u.Id != id).ToList();
            else
                errorMessage = "Smještajnu jedinicu nije moguće obrisati.";
        }
        catch (Exception ex) { errorMessage = $"Greška kod brisanja: {ex.Message}"; }
    }
}