@* @page "/housing-units"
@rendermode InteractiveServer
@using AzilEdu.Shared.Models

<PageTitle>Smještajne jedinice</PageTitle>

<MudText Typo="Typo.h4" Class="mb-2">Popis smještajnih jedinica</MudText>
<MudText Typo="Typo.body1" Class="mb-4">
    Ovdje se prikazuje pregled smještajnih jedinica za životinje koje se trenutačno nalaze u azilu.
</MudText>

<MudGrid Class="mb-4">
    <MudItem xs="12" sm="4">
        <MudPaper Class="pa-4">
            <MudText Typo="Typo.subtitle2">Ukupan broj jedinica</MudText>
            <MudText Typo="Typo.h5">@TotalNumber</MudText>
        </MudPaper>
    </MudItem>
    <MudItem xs="12" sm="4">
        <MudPaper Class="pa-4">
            <MudText Typo="Typo.subtitle2">Broj aktivnih jedinica</MudText>
            <MudText Typo="Typo.h5">@NumberOfActive</MudText>
        </MudPaper>
    </MudItem>
    <MudItem xs="12" sm="4">
        <MudPaper Class="pa-4">
            <MudText Typo="Typo.subtitle2">Broj punih jedinica</MudText>
            <MudText Typo="Typo.h5">@NumberOfFull</MudText>
        </MudPaper>
    </MudItem>
    <MudItem xs="12" sm="4">
        <MudPaper Class="pa-4">
            <MudText Typo="Typo.subtitle2">Ukupan slobodni kapacitet</MudText>
            <MudText Typo="Typo.h5">@FreeCapacity</MudText>
        </MudPaper>
    </MudItem>
</MudGrid>

<MudButtonGroup Color="Color.Primary" Variant="Variant.Outlined" Class="mb-4">
    <MudButton OnClick="@ShowAllAnimals">Sve</MudButton>
    <MudButton OnClick="@ShowAnimalsInShelter">Aktivne</MudButton>
    <MudButton OnClick="@ShowAdoptedAnimals">Pune</MudButton>
    <MudButton OnClick="@ShowAdoptedAnimals">Sa slobodnim mjestima</MudButton>
</MudButtonGroup>

<MudTable Items="@FilteredAnimals" Hover="true" Striped="true" Bordered="true" Dense="true">
    <HeaderContent>
        <MudTh>Slika</MudTh>
        <MudTh>Naziv</MudTh>
        <MudTh>Tip</MudTh>
        <MudTh>Kapacitet</MudTh>
        <MudTh>Zauzeto</MudTh>
        <MudTh>Slobodno</MudTh>
        <MudTh>Zadnje čišćenje</MudTh>
        <MudTh>Status</MudTh>
    </HeaderContent>
    <RowTemplate>
        <MudTd DataLabel="Slika">
            <MudAvatar Size="Size.Large">
                <MudImage Src="@context.ImageUrl" Alt="@context.Name" />
            </MudAvatar>
        </MudTd>
        <MudTd DataLabel="Slika">@context.Name</MudTd>
        <MudTd DataLabel="Naziv">@context.Species</MudTd>
        <MudTd DataLabel="Tip">@context.Breed</MudTd>
        <MudTd DataLabel="Kapacitet">@context.Gender</MudTd>
        <MudTd DataLabel="Zauzeto">@GetAgeText(context)</MudTd>
        <MudTd DataLabel="Slobodno">@GetArrivalDateText(context)</MudTd>
        <MudTd DataLabel="Zadnje čišćenje">@GetArrivalDateText(context)</MudTd>
        <MudTd DataLabel="Status">
            <MudChip T="string"
                     Color="@(context.IsAdopted ? Color.Success : Color.Warning)"
                     Variant="Variant.Filled">
                @GetAdoptionStatusText(context)
            </MudChip>
        </MudTd>
    </RowTemplate>
</MudTable>

