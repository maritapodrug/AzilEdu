@page "/housing-units/edit/{Id:int}"
@rendermode InteractiveServer
@using AzilEdu.Shared.DTOs
@using System.Net.Http.Json
@inject HttpClient Http
@inject NavigationManager Navigation

<MudText Typo="Typo.h4" GutterBottom="true">Uredi smještajnu jedinicu</MudText>

@if (isLoading)
{
    <div class="d-flex justify-center my-6">
        <MudProgressCircular Indeterminate="true" Color="Color.Primary" />
    </div>
}
else if (notFound)
{
    <MudAlert Severity="Severity.Warning">Smještajna jedinica nije pronađena.</MudAlert>
}
else
{
    @if (!string.IsNullOrWhiteSpace(errorMessage))
    {
        <MudAlert Severity="Severity.Error" Class="mb-4">@errorMessage</MudAlert>
    }

    <MudForm @ref="form">
        <MudStack Spacing="2">
            <MudTextField @bind-Value="model.Name"     Label="Naziv" Required="true" />
            <MudTextField @bind-Value="model.UnitType" Label="Vrsta" Required="true" />
            <MudNumericField @bind-Value="model.Capacity" Label="Kapacitet" />
            <MudNumericField @bind-Value="model.Occupied" Label="Zauzeto" />
            <MudDatePicker @bind-Date="lastCleanedAt"  Label="Zadnje čišćenje" />
            <MudCheckBox @bind-Value="model.IsActive"  Label="Aktivno" />
            <MudTextField @bind-Value="model.ImageUrl" Label="Putanja slike" />
            <MudTextField @bind-Value="model.Note"     Label="Opis" Lines="3" />

            <MudStack Row="true" Spacing="2">
                <MudButton ButtonType="ButtonType.Button"
                           OnClick="UpdateHousingUnit"
                           Variant="Variant.Filled"
                           Color="Color.Primary"
                           Disabled="isSaving">
                    @(isSaving ? "Spremam..." : "Spremi promjene")
                </MudButton>
                <MudButton Href="/housing-units" Variant="Variant.Text" Disabled="isSaving">
                    Odustani
                </MudButton>
            </MudStack>
        </MudStack>
    </MudForm>
}

@code {
    [Parameter] public int Id { get; set; }

    private MudForm? form;
    private SaveHousingUnitDto model = new();
    private DateTime? lastCleanedAt;

    private bool isLoading = true;
    private bool notFound;
    private bool isSaving;
    private string? errorMessage;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var unit = await Http.GetFromJsonAsync<HousingUnitDto>($"api/housing-units/{Id}");

            if (unit is null)
            {
                notFound = true;
                return;
            }

            model = new SaveHousingUnitDto
            {
                Name          = unit.Name,
                UnitType      = unit.UnitType,
                Capacity      = unit.Capacity,
                Occupied      = unit.Occupied,
                LastCleanedAt = unit.LastCleanedAt,
                IsActive      = unit.IsActive,
                ImageUrl      = unit.ImageUrl,
                Note          = unit.Note
            };

            lastCleanedAt = unit.LastCleanedAt;
        }
        catch (Exception ex)
        {
            errorMessage = $"Greška kod učitavanja: {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task UpdateHousingUnit()
    {
        if (form is not null)
        {
            await form.ValidateAsync();
            if (!form.IsValid) return;
        }

        if (model.Capacity < model.Occupied)
        {
            errorMessage = "Kapacitet ne smije biti manji od broja zauzetih mjesta.";
            return;
        }

        isSaving     = true;
        errorMessage = null;

        try
        {
            model.LastCleanedAt = lastCleanedAt;
            var response = await Http.PutAsJsonAsync($"api/housing-units/{Id}", model);

            if (response.IsSuccessStatusCode)
                Navigation.NavigateTo("/housing-units");
            else
                errorMessage = $"Ažuriranje nije uspjelo. Status: {(int)response.StatusCode}";
        }
        catch (Exception ex)
        {
            errorMessage = $"Greška kod spremanja: {ex.Message}";
        }
        finally
        {
            isSaving = false;
        }
    }
}
