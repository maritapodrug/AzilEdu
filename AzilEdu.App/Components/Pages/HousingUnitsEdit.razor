@page "/housing-units/edit/{Id:int}"
@rendermode InteractiveServer
@using AzilEdu.Shared.DTOs
@using System.Net.Http.Json
@inject HttpClient Http
@inject NavigationManager Navigation

<MudText Typo="Typo.h4" GutterBottom="true">Uredi smještajne jedinice</MudText>
<MudText Typo="Typo.body1" Class="mb-4">
    Na ovoj stranici dohvaćamo postojeći zapis i spremamo promjene preko PUT zahtjeva.
</MudText>

@if (!string.IsNullOrWhiteSpace(errorMessage))
{
    <MudAlert Severity="Severity.Error" Class="mb-4">
        @errorMessage
    </MudAlert>
}

<MudForm @ref="form">
    <MudStack Spacing="2">
        <MudTextField @bind-Value="model.Name" Label="Ime" Required="true" />
        <MudTextField @bind-Value="model.UnitType" Label="Vrsta" Required="true" />
        <MudNumericField @bind-Value="model.Capacity" Label="Kapacitet" />
        <MudNumericField @bind-Value="model.Occupied" Label="Zauzeto" />
        <MudDatePicker @bind-Date="lastCleanedAt" Label="Zadnje čišćenje" />
        <MudCheckBox @bind-Value="model.IsActive" Label="Aktivno" />
        <MudTextField @bind-Value="model.ImageUrl" Label="Putanja slike" />
        <MudTextField @bind-Value="model.Note" Label="Opis" Lines="3" />

        <MudButton ButtonType="ButtonType.Button"
                   OnClick="@UpdateHousingUnit"
                   Variant="Variant.Filled"
                   Color="Color.Primary">
            Spremi promjene
        </MudButton>
    </MudStack>
</MudForm>

@code {
    [Parameter] public int Id { get; set; }

    private MudForm? form;
    private SaveHousingUnitDto model = new();
    private DateTime? lastCleanedAt;
    private string? errorMessage;

    protected override async Task OnInitializedAsync()
    {
        var housingUnit = await Http.GetFromJsonAsync<HousingUnitDto>($"api/housing-units/{Id}");

        if (housingUnit is not null)
        {
            model = new SaveHousingUnitDto
            {
                Name = housingUnit.Name,
                UnitType = housingUnit.UnitType,
                Capacity = housingUnit.Capacity,
                Occupied = housingUnit.Occupied,
                LastCleanedAt = housingUnit.LastCleanedAt,
                IsActive = housingUnit.IsActive,
                ImageUrl = housingUnit.ImageUrl,
                Note = housingUnit.Note
            };

            lastCleanedAt = housingUnit.LastCleanedAt;
        }
    }

    private async Task UpdateHousingUnit()
    {
        errorMessage = null;

        if (form is not null)
        {
            await form.ValidateAsync();

            if (!form.IsValid)
            {
                return;
            }
        }
        
        if (model.Capacity < model.Occupied)
        {
            errorMessage = "Kapacitet ne smije biti manji od broja zauzetih mjesta.";
            return;
        }

        model.LastCleanedAt = lastCleanedAt;

        var response = await Http.PutAsJsonAsync($"api/housing-units/{Id}", model);

        if (response.IsSuccessStatusCode)
        {
            Navigation.NavigateTo("/housing-units");
        }
    }
}