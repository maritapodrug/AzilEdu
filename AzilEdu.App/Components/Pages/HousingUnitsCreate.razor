@page "/housing-units/create"
@rendermode InteractiveServer
@using AzilEdu.Shared.DTOs
@using System.Net.Http.Json
@inject HttpClient Http
@inject NavigationManager Navigation

<MudText Typo="Typo.h4" GutterBottom="true">Nova smještajna jedinica</MudText>
<MudText Typo="Typo.body1" Class="mb-4">
    Na ovoj stranici unosimo novi smještaj i podatke šaljemo prema API-ju preko POST zahtjeva.
</MudText>

@if (!string.IsNullOrWhiteSpace(errorMessage))
{
    <MudAlert Severity="Severity.Error" Class="mb-4">
        @errorMessage
    </MudAlert>
}

<MudStack Spacing="2">
    <MudTextField @bind-Value="model.Name" Label="Ime" Required="true" Immediate="true" />
    <MudTextField @bind-Value="model.UnitType" Label="Vrsta" Required="true" Immediate="true" />
    <MudNumericField @bind-Value="model.Capacity" Label="Kapacitet" Immediate="true" />
    <MudNumericField @bind-Value="model.Occupied" Label="Zauzeto" Immediate="true" />
    <MudDatePicker @bind-Date="lastCleanedAt" Label="Zadnje čišćenje" />
    <MudCheckBox @bind-Value="model.IsActive" Label="Aktivno" />
    <MudTextField @bind-Value="model.ImageUrl" Label="Putanja slike" Immediate="true" />
    <MudTextField @bind-Value="model.Note" Label="Opis" Lines="3" Immediate="true" />

    <MudButton ButtonType="ButtonType.Button"
               OnClick="SaveHousingUnit"
               Variant="Variant.Filled"
               Color="Color.Primary"
               Disabled="isSaving">
        @(isSaving ? "Spremam..." : "Spremi")
    </MudButton>
</MudStack>

@code {
    private string? errorMessage;
    private bool isSaving;

    private SaveHousingUnitDto model = new()
    {
        LastCleanedAt = DateTime.Today,
        ImageUrl = "/images/housing-units/placeholder.webp"
    };

    private DateTime? lastCleanedAt = DateTime.Today;

    private async Task SaveHousingUnit()
    {
        isSaving = true;
        errorMessage = null;

        try
        {
            if (string.IsNullOrWhiteSpace(model.Name) || string.IsNullOrWhiteSpace(model.UnitType))
            {
                errorMessage = "Upiši barem obavezna polja: ime i vrstu.";
                return;
            }

            if (model.Capacity < model.Occupied)
            {
                errorMessage = "Kapacitet ne smije biti manji od broja zauzetih mjesta.";
                return;
            }

            model.LastCleanedAt = lastCleanedAt;

            var response = await Http.PostAsJsonAsync("api/housing-units", model);

            if (response.IsSuccessStatusCode)
            {
                Navigation.NavigateTo("/housing-units");
                return;
            }

            errorMessage = $"Spremanje nije uspjelo. Status: {(int)response.StatusCode}";
        }
        catch (Exception ex)
        {
            errorMessage = $"Greška kod spremanja: {ex.Message}";
        }
        finally
        {
            isSaving = false;
        }
    }
}