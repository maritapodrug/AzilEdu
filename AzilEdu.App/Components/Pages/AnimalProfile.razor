@page "/animals/{Id:int}"
@rendermode InteractiveServer
@using AzilEdu.Shared.DTOs
@using Microsoft.AspNetCore.Components.Forms
@using AzilEdu.App.Services
@inject HttpClient Http
@inject CurrentUserService CurrentUser
@inject IDialogService DialogService

<PageTitle>Profil životinje</PageTitle>

@if (isLoading)
{
    <div class="d-flex justify-center my-6">
        <MudProgressCircular Indeterminate="true" Color="Color.Primary" />
    </div>
}
else if (!string.IsNullOrWhiteSpace(errorMessage))
{
    <MudAlert Severity="Severity.Error" Class="mb-4" ShowCloseIcon="true"
              CloseIconClicked="@(() => errorMessage = null)">@errorMessage</MudAlert>
}
else if (animal is null)
{
    <MudAlert Severity="Severity.Warning">Životinja nije pronađena.</MudAlert>
}
else
{
    <MudStack Spacing="3">

        
        <MudPaper Class="pa-5">
            <MudGrid>
                <MudItem xs="12" md="4">
                    <img src="@ProfileImageUrl"
                         alt="@($"Profilna slika — {animal.Name}")"
                         style="width:100%;height:280px;object-fit:cover;border-radius:8px;display:block;" />
                </MudItem>
                <MudItem xs="12" md="8">
                    <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="mb-1">
                        <MudText Typo="Typo.h3">@animal.Name</MudText>
                        @if (CanManageMedia)
                        {
                            <MudButton Href="@($"/animals/edit/{animal.Id}")"
                                       Variant="Variant.Outlined"
                                       Color="Color.Primary"
                                       Size="Size.Small"
                                       StartIcon="@Icons.Material.Filled.Edit">
                                Uredi podatke
                            </MudButton>
                        }
                    </MudStack>
                    <MudText Typo="Typo.subtitle1" Class="mb-2">
                        @animal.Species · @animal.Breed · @animal.Gender
                    </MudText>
                    <MudChip T="string" Color="@GetStatusColor(animal.Status)" Size="Size.Small" Class="mb-3">
                        @animal.Status
                    </MudChip>
                    <MudText Typo="Typo.body1">@animal.Description</MudText>
                </MudItem>
            </MudGrid>
        </MudPaper>

        
        @if (CanManageMedia)
        {
            <MudPaper Class="pa-5">
                <MudText Typo="Typo.h5" Class="mb-1">Dodaj sliku ili video</MudText>
                <MudText Typo="Typo.caption" Class="mb-3 mud-text-secondary">
                    Dopušteni formati: JPEG, PNG, WebP, MP4, WebM &nbsp;·&nbsp; Najveća veličina: 25 MB
                </MudText>

                <InputFile OnChange="HandleFileSelected"
                           accept="image/jpeg,image/png,image/webp,video/mp4,video/webm" />

                @if (selectedFile is not null)
                {
                    <MudText Typo="Typo.body2" Class="mt-2">
                        @selectedFile.Name (@FormatBytes(selectedFile.Size))
                    </MudText>

                    @if (selectedFile.Size > MaxFileSize)
                    {
                        <MudAlert Severity="Severity.Error" Class="mt-2">
                            Datoteka je prevelika. Maksimalna veličina je 25 MB.
                        </MudAlert>
                    }
                }

                @if (!string.IsNullOrWhiteSpace(uploadError))
                {
                    <MudAlert Severity="Severity.Error" Class="mt-2">@uploadError</MudAlert>
                }

                <MudTextField @bind-Value="caption"
                              Label="Opis datoteke (neobavezno)"
                              Variant="Variant.Outlined"
                              Class="mt-3" />

                <MudButton Color="Color.Primary"
                           Variant="Variant.Filled"
                           OnClick="UploadMedia"
                           Disabled="@(selectedFile is null || isUploading || selectedFile.Size > MaxFileSize)"
                           Class="mt-3">
                    @(isUploading ? "Učitavam..." : "Dodaj na profil")
                </MudButton>
            </MudPaper>
        }

        
        <MudText Typo="Typo.h5">Galerija</MudText>

        @if (mediaItems.Count == 0)
        {
            <MudAlert Severity="Severity.Info">
                Za ovu životinju još nema slika ni videozapisa.
            </MudAlert>
        }
        else
        {
            <MudGrid>
                @foreach (var media in mediaItems)
                {
                    <MudItem xs="12" sm="6" md="4">
                        <MudCard>
                            @if (media.MediaType == "Image")
                            {
                                <img src="@media.Url"
                                     alt="@(string.IsNullOrWhiteSpace(media.Caption) ? $"Slika — {animal.Name}" : media.Caption)"
                                     style="width:100%;height:240px;object-fit:cover;display:block;" />
                            }
                            else
                            {
                                <video controls preload="metadata"
                                       aria-label="@(string.IsNullOrWhiteSpace(media.Caption) ? $"Video — {animal.Name}" : media.Caption)"
                                       style="width:100%;height:240px;background:#111;display:block;">
                                    <source src="@media.Url" type="@media.ContentType" />
                                    Vaš preglednik ne podržava HTML video.
                                </video>
                            }

                            <MudCardContent>
                                <MudText>@(media.Caption ?? media.OriginalFileName)</MudText>
                                @if (media.IsCover)
                                {
                                    <MudChip T="string" Color="Color.Primary" Size="Size.Small">
                                        Naslovna slika
                                    </MudChip>
                                }
                            </MudCardContent>

                            @if (CanManageMedia)
                            {
                                <MudCardActions>
                                    @if (media.MediaType == "Image" && !media.IsCover)
                                    {
                                        <MudButton Size="Size.Small"
                                                   OnClick="@(() => SetCover(media.Id))">
                                            Postavi kao naslovnu
                                        </MudButton>
                                    }
                                    <MudButton Color="Color.Error"
                                               Size="Size.Small"
                                               OnClick="@(() => ConfirmDeleteMedia(media.Id))">
                                        Izbriši
                                    </MudButton>
                                </MudCardActions>
                            }
                        </MudCard>
                    </MudItem>
                }
            </MudGrid>
        }

        
        @if (CanManageMedia)
        {
            <MudPaper Class="pa-5" Elevation="1">
                <MudText Typo="Typo.h5" Class="mb-2">AI objava za društvene mreže</MudText>

                <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center">
                    <MudButton OnClick="GenerateSocialPost"
                               Variant="Variant.Outlined"
                               Color="Color.Secondary"
                               Disabled="isGeneratingSocialPost">
                        @(isGeneratingSocialPost ? "Generiram..." : "Predloži objavu")
                    </MudButton>

                    @if (!string.IsNullOrWhiteSpace(socialPost))
                    {
                        <MudButton Variant="Variant.Text"
                                   Color="Color.Default"
                                   Size="Size.Small"
                                   OnClick="@(() => socialPost = null)">
                            Odbaci
                        </MudButton>
                    }
                </MudStack>

                @if (!string.IsNullOrWhiteSpace(socialPost))
                {
                    <MudTextField @bind-Value="socialPost"
                                  Label="Uredivi prijedlog objave"
                                  Lines="5"
                                  Variant="Variant.Outlined"
                                  Class="mt-3" />
                }
            </MudPaper>
        }

    </MudStack>
}

@code {
    private const long MaxFileSize = 25 * 1024 * 1024;

    [Parameter] public int Id { get; set; }

    private AnimalDto? animal;
    private List<AnimalMediaDto> mediaItems = new();
    private IBrowserFile? selectedFile;
    private string? caption;
    private string? errorMessage;
    private string? uploadError;
    private bool isLoading = true;
    private bool isUploading;
    private bool isGeneratingSocialPost;
    private string? socialPost;

    private bool CanManageMedia => CurrentUser.HasAnyRole("Admin", "Employee");

    private string ProfileImageUrl =>
        mediaItems.FirstOrDefault(m => m.IsCover && m.MediaType == "Image")?.Url
        ?? animal?.ImageUrl
        ?? "/images/animals/placeholder.svg";

    protected override async Task OnParametersSetAsync()
    {
        await LoadProfile();
    }

    private async Task LoadProfile()
    {
        isLoading     = true;
        errorMessage  = null;
        socialPost    = null;

        try
        {
            animal = await Http.GetFromJsonAsync<AnimalDto>($"api/animals/{Id}");
            if (animal is not null)
                await LoadMedia();
        }
        catch (Exception ex)
        {
            errorMessage = $"Profil nije moguće učitati: {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task LoadMedia()
    {
        mediaItems = await Http.GetFromJsonAsync<List<AnimalMediaDto>>(
            $"api/animals/{Id}/media") ?? new();
    }

    private void HandleFileSelected(InputFileChangeEventArgs args)
    {
        selectedFile = args.File;
        uploadError  = null;
    }

    private async Task UploadMedia()
    {
        if (selectedFile is null) return;

        if (selectedFile.Size > MaxFileSize)
        {
            uploadError = "Datoteka je prevelika. Maksimalna veličina je 25 MB.";
            return;
        }

        isUploading = true;
        uploadError = null;

        try
        {
            using var formContent = new MultipartFormDataContent();
            await using var stream = selectedFile.OpenReadStream(MaxFileSize);
            using var fileContent  = new StreamContent(stream);

            fileContent.Headers.ContentType =
                new System.Net.Http.Headers.MediaTypeHeaderValue(selectedFile.ContentType);

            formContent.Add(fileContent, "file", selectedFile.Name);
            formContent.Add(new StringContent(caption ?? string.Empty), "caption");

            var response = await Http.PostAsync($"api/animals/{Id}/media", formContent);

            if (!response.IsSuccessStatusCode)
            {
                uploadError = await response.Content.ReadAsStringAsync();
                return;
            }

            selectedFile = null;
            caption      = null;
            await LoadMedia();
        }
        catch (Exception ex)
        {
            uploadError = $"Datoteku nije moguće učitati: {ex.Message}";
        }
        finally
        {
            isUploading = false;
        }
    }

    private async Task ConfirmDeleteMedia(int mediaId)
    {
        var options = new DialogOptions { CloseOnEscapeKey = true };
        var dialog  = await DialogService.ShowAsync<ConfirmDialog>("Potvrda brisanja", options);
        var result  = await dialog.Result;
        if (result is null || result.Canceled) return;

        try
        {
            var response = await Http.DeleteAsync($"api/animals/{Id}/media/{mediaId}");
            if (response.IsSuccessStatusCode)
                await LoadMedia();
            else
                errorMessage = "Medij nije moguće obrisati.";
        }
        catch (Exception ex)
        {
            errorMessage = $"Greška kod brisanja: {ex.Message}";
        }
    }

    private async Task SetCover(int mediaId)
    {
        var response = await Http.PutAsync($"api/animals/{Id}/media/{mediaId}/cover", null);
        if (response.IsSuccessStatusCode)
            await LoadMedia();
        else
            errorMessage = "Naslovnu sliku nije moguće postaviti.";
    }

    private async Task GenerateSocialPost()
    {
        if (animal is null) return;

        isGeneratingSocialPost = true;
        errorMessage           = null;

        try
        {
            var response = await Http.PostAsJsonAsync("api/ai/text", new AiTextRequestDto
            {
                Purpose = "social-post",
                Input   =
                    $"Ime: {animal.Name}; Vrsta: {animal.Species}; " +
                    $"Pasmina: {animal.Breed}; Status: {animal.Status}; " +
                    $"Opis: {animal.Description}."
            });

            if (!response.IsSuccessStatusCode)
            {
                errorMessage = await response.Content.ReadAsStringAsync();
                return;
            }

            var result = await response.Content.ReadFromJsonAsync<AiTextResponseDto>();
            socialPost = result?.Text;
        }
        catch (Exception ex)
        {
            errorMessage = $"Objavu nije moguće generirati: {ex.Message}";
        }
        finally
        {
            isGeneratingSocialPost = false;
        }
    }

    private static string FormatBytes(long bytes) =>
        bytes >= 1024 * 1024
            ? $"{bytes / 1024d / 1024d:0.0} MB"
            : $"{bytes / 1024d:0.0} KB";

    private static Color GetStatusColor(string status) => status switch
    {
        "Dostupna za udomljenje" => Color.Success,
        "Rezervirana"            => Color.Info,
        "Udomljena"              => Color.Secondary,
        "Na liječenju"           => Color.Warning,
        _                        => Color.Default
    };
}
