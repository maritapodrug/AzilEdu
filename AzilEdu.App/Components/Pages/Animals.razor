@page "/animals"

<MudText Typo="Typo.h3" GutterBottom="true">
    Animals
</MudText>

<MudText Typo="Typo.body1" Class="mb-4">
    Pregled životinja koje se nalaze u sustavu azila.
</MudText>

<MudGrid>


    <MudItem xs="12" md="4">
        <MudCard>
            <MudCardMedia Image="images/animals.jpg" Height="200" />
            <MudCardContent>
                <MudText Typo="Typo.h5">Sve životinje</MudText>
                <MudText Typo="Typo.body2">Pregled svih životinja evidentiranih u azilu.</MudText>
            </MudCardContent>
            <MudCardActions>
                <MudButton Variant="Variant.Filled" Color="Color.Primary">Otvori pregled</MudButton>
            </MudCardActions>
        </MudCard>
    </MudItem>

    <MudItem xs="12" md="4">
        <MudCard>
            <MudCardMedia Image="images/pasmine.jpg" Height="200" />
            <MudCardContent>
                <MudText Typo="Typo.h5">Vrste i pasmine</MudText>
                <MudText Typo="Typo.body2"> Organizacija životinja prema vrstama i pasminama.</MudText>
            </MudCardContent>
            <MudCardActions>
                <MudButton Variant="Variant.Filled" Color="Color.Primary">Otvori pregled</MudButton>
            </MudCardActions>
        </MudCard>
    </MudItem>

    <MudItem xs="12" md="4">
        <MudCard>
            <MudCardMedia Image="images/azil.jpg" Height="200" />
            <MudCardContent>
                <MudText Typo="Typo.h5">Smještaj</MudText>
                <MudText Typo="Typo.body2"> Pregled bokseva, kaveza i drugih smještajnih jedinica.</MudText>
            </MudCardContent>
            <MudCardActions>
                <MudButton Variant="Variant.Filled" Color="Color.Primary">Otvori pregled</MudButton>
            </MudCardActions>
        </MudCard>
    </MudItem>
</MudGrid>

