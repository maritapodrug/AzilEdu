@page "/volunteers/edit/{Id:int}"
@rendermode InteractiveServer
@using AzilEdu.Shared.DTOs
@using System.Net.Http.Json
@inject HttpClient Http
@inject NavigationManager Navigation

<MudText Typo="Typo.h4" GutterBottom="true">Uredi volontera</MudText>

@if (isLoading)
{
    <div class="d-flex justify-center my-6">
        <MudProgressCircular Indeterminate="true" Color="Color.Primary" />
    </div>
}
else if (notFound)
{
    <MudAlert Severity="Severity.Warning">Volonter nije pronađen.</MudAlert>
}
else
{
    @if (!string.IsNullOrWhiteSpace(errorMessage))
    {
        <MudAlert Severity="Severity.Error" Class="mb-4">@errorMessage</MudAlert>
    }

    <MudForm @ref="form">
        <MudStack Spacing="2">
            <MudTextField @bind-Value="model.FirstName" Label="Ime"     Required="true" />
            <MudTextField @bind-Value="model.LastName"  Label="Prezime" Required="true" />
            <MudTextField @bind-Value="model.Email"     Label="Email" />
            <MudTextField @bind-Value="model.Phone"     Label="Telefon" />
            <MudTextField @bind-Value="model.Skills"    Label="Vještine" Lines="2" />
            <MudDatePicker @bind-Date="availableFrom"   Label="Dostupan od" />

            <MudSelect T="int" Label="Status" @bind-Value="model.VolunteerStatusId"
                       Variant="Variant.Outlined" Required="true">
                @foreach (var status in statusList)
                {
                    <MudSelectItem Value="@status.Id">@status.Name</MudSelectItem>
                }
            </MudSelect>

            <MudTextField @bind-Value="model.Notes" Label="Napomena" Lines="3" />

            <MudStack Row="true" Spacing="2">
                <MudButton ButtonType="ButtonType.Button"
                           OnClick="UpdateVolunteer"
                           Variant="Variant.Filled"
                           Color="Color.Primary"
                           Disabled="isSaving">
                    @(isSaving ? "Spremam..." : "Spremi promjene")
                </MudButton>
                <MudButton Href="/volunteers" Variant="Variant.Text" Disabled="isSaving">
                    Odustani
                </MudButton>
            </MudStack>
        </MudStack>
    </MudForm>
}

@code {
    [Parameter] public int Id { get; set; }

    private MudForm? form;
    private SaveVolunteerDto model = new();
    private DateTime? availableFrom;
    private List<LookupDto> statusList = new();

    private bool isLoading = true;
    private bool notFound;
    private bool isSaving;
    private string? errorMessage;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            statusList = await Http.GetFromJsonAsync<List<LookupDto>>("api/volunteerstatuses") ?? new();
            var volunteer = await Http.GetFromJsonAsync<VolunteerDto>($"api/volunteers/{Id}");

            if (volunteer is null)
            {
                notFound = true;
                return;
            }

            model = new SaveVolunteerDto
            {
                FirstName          = volunteer.FirstName,
                LastName           = volunteer.LastName,
                Email              = volunteer.Email,
                Phone              = volunteer.Phone,
                Skills             = volunteer.Skills,
                AvailableFrom      = volunteer.AvailableFrom,
                Notes              = volunteer.Notes,
                VolunteerStatusId  = volunteer.VolunteerStatusId
            };

            availableFrom = volunteer.AvailableFrom;

            if (model.VolunteerStatusId == 0 && statusList.Count > 0)
                model.VolunteerStatusId = statusList[0].Id;
        }
        catch (Exception ex)
        {
            errorMessage = $"Greška kod učitavanja: {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task UpdateVolunteer()
    {
        if (form is not null)
        {
            await form.ValidateAsync();
            if (!form.IsValid) return;
        }

        isSaving     = true;
        errorMessage = null;

        try
        {
            model.AvailableFrom = availableFrom;
            var response = await Http.PutAsJsonAsync($"api/volunteers/{Id}", model);

            if (response.IsSuccessStatusCode)
                Navigation.NavigateTo("/volunteers");
            else
                errorMessage = $"Ažuriranje nije uspjelo. Status: {(int)response.StatusCode}";
        }
        catch (Exception ex)
        {
            errorMessage = $"Greška kod spremanja: {ex.Message}";
        }
        finally
        {
            isSaving = false;
        }
    }
}
