@page "/zad4"
@rendermode InteractiveServer

@if (prikaziPoruku)
{
	<p>Nestajuca poruka</p>
}
<button @onclick="NestajucaPoruka">@natpis</button>

@code{
	string natpis = "Sakrij poruku";
	bool prikaziPoruku = true;

	void NestajucaPoruka()
	{
		prikaziPoruku = !prikaziPoruku;
		natpis = prikaziPoruku ? "Sakrij poruku" : "Prikaži poruku";
	}
}
