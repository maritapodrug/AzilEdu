@page "/zad1"
@rendermode InteractiveServer

<p class="@nazivKlase">Klikni gumb za promjenu boje</p>

<button @onclick="PromjenaBoje">Promjeni boju</button>

@code {
    string nazivKlase = "tekst-plavi";

    void PromjenaBoje()
    {
		nazivKlase= nazivKlase == "tekst-plavi" 
                    ? nazivKlase = "tekst-crveni" 
                    : nazivKlase = "tekst-plavi";
    }
}
