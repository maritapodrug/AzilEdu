@page "/employees"
@rendermode InteractiveServer
@using AzilEdu.Shared.DTOs
@using System.Net.Http.Json
@inject HttpClient Http

<PageTitle>Djelatnici</PageTitle>

<MudText Typo="Typo.h4" GutterBottom="true">Djelatnici</MudText>
<MudText Typo="Typo.body1" Class="mb-4">
    Popis djelatnika azila s mogućnošću pretrage i filtriranja po statusu.
</MudText>

<MudPaper Class="pa-4 mb-4">
    <MudGrid>
        <MudItem xs="12" md="5">
            <MudTextField @bind-Value="searchString"
                          Label="Pretraži djelatnike"
                          Placeholder="Ime, prezime ili broj djelatnika"
                          Variant="Variant.Outlined"
                          Immediate="true"
                          Adornment="Adornment.Start"
                          AdornmentIcon="@Icons.Material.Filled.Search" />
        </MudItem>

        <MudItem xs="12" md="4">
            <MudSelect T="string"
                       Label="Status"
                       @bind-Value="selectedStatus"
                       Variant="Variant.Outlined"
                       Clearable="true">
                @foreach (var status in statusList)
                {
                    <MudSelectItem Value="@status.Name">@status.Name</MudSelectItem>
                }
            </MudSelect>
        </MudItem>

        <MudItem xs="12" md="3" Class="d-flex align-center">
            <MudButton Variant="Variant.Outlined"
                       Color="Color.Secondary"
                       StartIcon="@Icons.Material.Filled.Refresh"
                       OnClick="ResetFilters">
                Očisti
            </MudButton>
        </MudItem>
    </MudGrid>
</MudPaper>

@if (isLoading)
{
    <div class="d-flex justify-center my-6">
        <MudProgressCircular Indeterminate="true" Color="Color.Primary" />
    </div>
}
else if (!string.IsNullOrWhiteSpace(errorMessage))
{
    <MudAlert Severity="Severity.Error" Class="mb-4">@errorMessage</MudAlert>
}
else
{
<MudTable Items="@employees"
          Filter="FilterEmployees"
          Hover="true"
          Striped="true"
          Bordered="true"
          Dense="true">
    <HeaderContent>
        <MudTh>Prezime</MudTh>
        <MudTh>Ime</MudTh>
        <MudTh>Email</MudTh>
        <MudTh>Telefon</MudTh>
        <MudTh>Broj djelatnika</MudTh>
        <MudTh>Pozicija</MudTh>
        <MudTh>Status</MudTh>
    </HeaderContent>

    <RowTemplate>
        <MudTd DataLabel="Prezime">@context.LastName</MudTd>
        <MudTd DataLabel="Ime">@context.FirstName</MudTd>
        <MudTd DataLabel="Email">@context.Email</MudTd>
        <MudTd DataLabel="Telefon">@context.Phone</MudTd>
        <MudTd DataLabel="Broj djelatnika">@context.EmployeeNumber</MudTd>
        <MudTd DataLabel="Pozicija">@context.Position</MudTd>
        <MudTd DataLabel="Status">
            <MudChip T="string" Color="@GetStatusColor(context.Status)" Variant="Variant.Filled">
                @context.Status
            </MudChip>
        </MudTd>
    </RowTemplate>

    <NoRecordsContent>
        <MudText Typo="Typo.body1" Class="pa-4">
            Nema rezultata za zadane kriterije pretrage i filtera.
        </MudText>
    </NoRecordsContent>
</MudTable>
}

@code {
    private List<EmployeeDto> employees = new();
    private List<LookupDto> statusList = new();
    private string searchString = string.Empty;
    private string? selectedStatus;
    private bool isLoading = true;
    private string? errorMessage;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            employees  = await Http.GetFromJsonAsync<List<EmployeeDto>>("api/employees")        ?? new();
            statusList = await Http.GetFromJsonAsync<List<LookupDto>>("api/employeestatuses")   ?? new();
        }
        catch (Exception ex) { errorMessage = $"Greška kod učitavanja: {ex.Message}"; }
        finally { isLoading = false; }
    }

    private bool FilterEmployees(EmployeeDto employee)
    {
        if (!string.IsNullOrWhiteSpace(searchString))
        {
            var term = searchString.Trim().ToLower();

            var matchesSearch =
                (!string.IsNullOrWhiteSpace(employee.FirstName) && employee.FirstName.ToLower().Contains(term)) ||
                (!string.IsNullOrWhiteSpace(employee.LastName) && employee.LastName.ToLower().Contains(term)) ||
                (!string.IsNullOrWhiteSpace(employee.EmployeeNumber) && employee.EmployeeNumber.ToLower().Contains(term));

            if (!matchesSearch)
                return false;
        }

        if (!string.IsNullOrWhiteSpace(selectedStatus) &&
            !string.Equals(employee.Status, selectedStatus, StringComparison.OrdinalIgnoreCase))
        {
            return false;
        }

        return true;
    }

    private void ResetFilters()
    {
        searchString = string.Empty;
        selectedStatus = null;
    }

    private Color GetStatusColor(string status)
    {
        return status switch
        {
            "Aktivan" => Color.Success,
            "Na dopustu ili bolovanju" => Color.Warning,
            "Neaktivan" => Color.Default,
            _ => Color.Default
        };
    }
}
